.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
build/
dist/
.DS_Store
working/*
!working/.gitkeep

# Each transformer's input/ and output/ folders are kept via .gitkeep, but the
# source art and generated logos inside them are not tracked.
transformers/*/input/*
!transformers/*/input/.gitkeep
transformers/*/output/*
!transformers/*/output/.gitkeep